# LifeOS Server Configuration

PORT=3001
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Google Gemini API Key
# Get your free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Configurable Gemini Model: gemini-flash-lite-latest (fastest & high quota) or gemini-3.1-flash-lite
GEMINI_MODEL="gemini-flash-lite-latest"

# JWT Authentication Secret
JWT_SECRET="replace-with-a-secure-random-secret-key"

NODE_ENV=development
